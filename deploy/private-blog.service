[Unit]
Description=Private Blog FastAPI application
After=network.target

[Service]
Type=simple
User=private-blog
Group=private-blog
WorkingDirectory=/opt/private-blog/app
EnvironmentFile=/etc/private-blog/private-blog.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/private-blog/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${APP_PORT} --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/private-blog /var/backups/private-blog
UMask=0027
MemoryMax=700M
TasksMax=64
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
