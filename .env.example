APP_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./private_blog.db
DATA_DIR=./data
BACKUP_DIR=./data/backups
APP_TIMEZONE=Asia/Shanghai
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=524288000
MAX_UPLOAD_TOTAL_BYTES=21474836480
# Scheduled article email notifications (leave SMTP_HOST empty to disable)
APP_BASE_URL=https://your-blog.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
